class Ticket:
#create a class called Ticket with attributes ticket_id, ticket_price, and status    
    def __init__(self,ticket_name, ticket_id, ticket_price, status):
    #define the attributes using function parameters
        self.ticket_name = ticket_name
        self.ticket_id = ticket_id
        self.ticket_price = ticket_price
        self.status = status

    def display(self):
    #define a method to display the ticket information
        print(f"Ticket Name: {self.ticket_name}")
        print(f"Ticket ID: {self.ticket_id}")
        print(f"Ticket Price: ${self.ticket_price:.2f}")
        print(f"Status: {self.status}")

    def generate_password(self):
    #define a method to generate a password for the ticket
        
        new_password = "" #password variable to store the generated password is a string
        #define a method to generate a password for the ticket
        #generate a password using the first three letters of the ticket name and the last three digits of the ticket ID
        new_password = self.ticket_name[:3]
        new_password += str(self.ticket_id)[-3:]
        return new_password


 
# Example usage:
ticket1 = Ticket("Desi", 23101, 50.0, "Available")
ticket1.display() 
print(ticket1.generate_password()) 